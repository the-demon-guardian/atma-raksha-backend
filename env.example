PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# Turso (free, persistent database - replaces local SQLite file)
# Get these from: turso.tech -> create database -> "Connect" tab
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Your deployed backend's public URL (e.g. from Render, after first deploy)
# Needed so Twilio can reach /voice/twiml for the automated call.
PUBLIC_SERVER_URL=https://your-app-name.onrender.com

# Gmail App Password (NOT your normal Gmail password — generate a fresh
# App Password at myaccount.google.com -> Security -> App Passwords,
# and revoke any App Password that was ever pasted into a chat).
EMAIL_USER=your_gmail_address_here@gmail.com
EMAIL_APP_PASSWORD=your_new_gmail_app_password_here

# Twilio (rotate your Auth Token before using — see earlier chat warning)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_new_rotated_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+16624902545
# Twilio Verify Service SID (create one free in Twilio Console -> Verify -> Services)
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_here

# Gemini (rotate your key before using — see earlier chat warning)
GEMINI_API_KEY=your_new_rotated_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# Police helpline number for final escalation tier (example placeholder)
POLICE_HELPLINE_NUMBER=+91XXXXXXXXXXenv.example
